# Global AI Investor - environment template
# Copy to .env (never commit .env). Actual key is stored encrypted via DPAPI in data/settings.

# Formal-stage LLM (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local AI experiment (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Runtime
GAI_ENV=development
